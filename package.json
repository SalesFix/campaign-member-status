{
	"name": "campaign-member-status",
	"private": true,
	"version": "1.3.0",
	"description": "Protected Campaign Member Statuses by Campaign Type, with a Campaign Member Statuses management tab",
	"scripts": {
		"apex:test": "sf apex run test --test-level RunLocalTests --result-format human --code-coverage --wait 30",
		"prettier": "prettier --write \"force-app/**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,yaml,yml}\" \"unpackaged/**/*.trigger\" \"*.md\" \"docs/**/*.md\"",
		"prettier:verify": "prettier --list-different \"force-app/**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,yaml,yml}\" \"unpackaged/**/*.trigger\"",
		"test": "npm run test:unit",
		"test:unit": "sfdx-lwc-jest --skipApiVersionCheck -- --passWithNoTests",
		"test:unit:coverage": "sfdx-lwc-jest --coverage --skipApiVersionCheck -- --passWithNoTests",
		"test:unit:debug": "sfdx-lwc-jest --debug --skipApiVersionCheck -- --passWithNoTests",
		"test:unit:watch": "sfdx-lwc-jest --watch --skipApiVersionCheck -- --passWithNoTests"
	},
	"devDependencies": {
		"@prettier/plugin-xml": "^3.4.2",
		"@salesforce/sfdx-lwc-jest": "^7.9.0",
		"prettier": "^3.9.10",
		"prettier-plugin-apex": "^2.3.0"
	}
}
